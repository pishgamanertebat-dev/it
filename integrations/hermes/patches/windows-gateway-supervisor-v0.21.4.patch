+def test_launch_does_not_detach_when_the_supervisor_is_already_running(monkeypatch, capsys):
+    """IgnoreNew reports the task as already running. That is the live supervisor,
+    including its post-crash backoff, so a second python must not be spawned."""
+    monkeypatch.setattr(gateway_windows, "is_task_registered", lambda: True)
+    monkeypatch.setattr(gateway_windows, "get_task_name", lambda: "Hermes_Gateway")
+    monkeypatch.setattr(gateway_windows, "_spawn_detached", lambda: pytest.fail("must not detach beside a live supervisor"))
+    monkeypatch.setattr(gateway_windows, "_report_gateway_start", lambda via: None)
+    monkeypatch.setattr(
+        gateway_windows, "_exec_schtasks",
+        lambda args: (1, "", "ERROR: The task is already running."),
+    )
+    gateway_windows._launch_gateway_process()
+    assert "already running" in capsys.readouterr().out.lower()
