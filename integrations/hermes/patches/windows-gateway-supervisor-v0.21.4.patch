+        # wscript still has no console, so logon CTRL_CLOSE does not land on the launcher (#45599).
+        "' Supervisor loop: wait for the gateway, then restart only after a real child exit.",
+        "fastFails = 0",
+        "Do",
+        "  startedAt = Now",
+        f"  exitCode = sh.Run({q(command_line)}, 0, True)",
+        "  If exitCode = 0 Or exitCode = 78 Then Exit Do",
+        '  elapsedSec = DateDiff("s", startedAt, Now)',
+        f"  If exitCode = 75 Or elapsedSec >= {_VBS_STABLE_RUN_S} Then",
+        "    fastFails = 0",
+        f"    WScript.Sleep {_VBS_RESTART_BACKOFF_MS}",
+        "  Else",
+        "    fastFails = fastFails + 1",
+        f"    If fastFails >= {_VBS_FAST_FAILS_BEFORE_PARK} Then WScript.Quit 0",
+        f"    delayMs = {_VBS_RESTART_BACKOFF_MS} * (2 ^ (fastFails - 1))",
+        f"    If delayMs > {_VBS_BACKOFF_CAP_MS} Then delayMs = {_VBS_BACKOFF_CAP_MS}",
+        "    WScript.Sleep delayMs",
+        "  End If",
+        "Loop",
+        "WScript.Quit 0",
     ]
     return "\r\n".join(lines) + "\r\n"
 
