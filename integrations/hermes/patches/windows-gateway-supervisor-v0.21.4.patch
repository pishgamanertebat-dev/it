+# Short pause after a restartable child exit. Exit 75 (liveness watchdog) and any child that
+# stayed up at least ``_VBS_STABLE_RUN_S`` use only this delay.
+# A child that dies faster than that, with any other code, is a fast crash. Those count toward
+# ``gateway.respawn_storm``'s max_starts (5). The in-process breaker
+# (``record_start_and_check_storm``) only runs once Python reaches ``_respawn_storm_backoff``,
+# so a crash that never gets that far would otherwise respawn every 15s forever. This launcher
+# applies the same cap and the same 300s backoff ceiling, then parks (exit 0) so Task Scheduler
+# RestartOnFailure does not start another copy. ``hermes gateway start`` begins a fresh supervisor.
+_VBS_RESTART_BACKOFF_MS = 15000
+_VBS_STABLE_RUN_S = 60
+_VBS_FAST_FAILS_BEFORE_PARK = 5
+_VBS_BACKOFF_CAP_MS = 300000
 
