+def _launch_gateway_process() -> None:
+    """Start one gateway under the Scheduled Task supervisor when that task exists.
+
+    ``schtasks /Run`` launches the hidden wscript supervisor, which owns the python process.
+    A direct spawn is only the fallback for a missing task or a /Run that did not start: an
+    extra detached process would not be restarted after exit 75. "Already running" is not a
+    fallback — IgnoreNew means the supervisor is alive and a second python would duplicate it.
+    """
+    if is_task_registered():
+        code, out, err = _exec_schtasks(["/Run", "/TN", get_task_name()])
+        detail = (err or out or "").strip()
+        if code == 0:
+            _report_gateway_start("Scheduled Task")
+            return
+        if "already running" in detail.lower():
+            print("ℹ Scheduled Task supervisor is already running; not spawning a second gateway.")
+            _report_gateway_start("Scheduled Task")
+            return
+        print(f"⚠ schtasks /Run failed (code {code}): {detail}")
+        print("  Falling back to a direct hidden spawn. That process is not supervised by the task.")
+    _spawn_detached()
     _report_gateway_start("direct spawn")
 
 
