+++ b/tests/hermes_state/test_title_joiners.py
@@ -0,0 +1,14 @@
+"""Unicode title persistence keeps shaping joiners, strips hostile bidi overrides."""
+from hermes_state import SessionDB
+
+
+def test_title_roundtrip_preserves_persian_and_emoji_joiners(tmp_path):
+    db = SessionDB(tmp_path / 'state.db')
+    try:
+        title = 'حمید هدایتی — می\u200cکند 👨\u200d👩\u200d👧\u200d👦'
+        db.create_session('unicode-title', 'bale')
+        db.set_session_title('unicode-title', '\u202e' + title + '\u202c')
+        assert db.get_session_title('unicode-title') == title
+        assert db.list_sessions_rich()[0]['title'] == title
+    finally:
+        db.close()
