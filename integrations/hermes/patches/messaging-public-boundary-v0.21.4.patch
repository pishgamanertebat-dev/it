@@ -0,0 +1,25 @@
+"""Invocation-scoped network restrictions; CLI retains its configured URL policy."""
+from contextvars import ContextVar
+from contextlib import contextmanager
+
+PUBLIC_NETWORK_ONLY = ContextVar("hermes_public_network_only", default=False)
+
+def is_messaging_invocation(agent=None):
+    if PUBLIC_NETWORK_ONLY.get():
+        return True
+    if agent is not None and getattr(agent, "_public_network_only", False):
+        return True
+    if agent is not None:
+        source = getattr(agent, "_messaging_source_platform", None) or getattr(agent, "platform", None)
+        if source in {"bale", "telegram"}:
+            return True
+    from gateway.session_context import get_session_env
+    return get_session_env("HERMES_SESSION_PLATFORM", "") in {"bale", "telegram"}
+
+@contextmanager
+def public_network_scope(enabled=True):
+    token = PUBLIC_NETWORK_ONLY.set(bool(enabled) or PUBLIC_NETWORK_ONLY.get())
+    try:
+        yield
+    finally:
+        PUBLIC_NETWORK_ONLY.reset(token)
