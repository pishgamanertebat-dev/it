+@pytest.mark.parametrize("requested", [["terminal"],["file"],["skills"],["connections"],["mcp-any"],["hermes-cli"],["web","terminal"]])
+def test_child_requested_tools_cannot_escalate(requested):
+    parent=SimpleNamespace(platform="bale",enabled_toolsets=["web","skills_readonly","no_mcp"],disabled_toolsets=[],valid_tool_names={"web_search","web_extract","skills_list","skill_view"})
+    enabled,disabled=_resolve_child_toolsets(parent,requested,"leaf")
+    names={n for ts in enabled for n in resolve_toolset(ts)}
+    assert names<=parent.valid_tool_names
+    assert "no_mcp" in enabled
+    assert "terminal" not in names and "read_file" not in names and "skill_manage" not in names
+
+@pytest.mark.parametrize("actual", [None,set(),{"web_search"}])
+def test_none_toolset_fallback_and_nested_ceiling(actual):
+    parent=SimpleNamespace(platform="telegram",enabled_toolsets=None,disabled_toolsets=[])
+    if actual is not None: parent.valid_tool_names=actual
+    enabled,disabled=_resolve_child_toolsets(parent,None,"orchestrator")
+    names={n for ts in enabled for n in resolve_toolset(ts)}
+    assert names <= (actual or set())
+    assert "terminal" not in names and "read_file" not in names and "delegate_task" not in names
+    child=SimpleNamespace(platform="subagent",_public_network_only=True,enabled_toolsets=enabled,disabled_toolsets=disabled,valid_tool_names=names,_inherited_tool_ceiling=frozenset(actual or set()))
+    nested,_=_resolve_child_toolsets(child,["hermes-cli","terminal","file","web"],"orchestrator")
+    assert {n for ts in nested for n in resolve_toolset(ts)}<=names
+
+def test_partial_plugin_toolset_does_not_expand_parent(monkeypatch):
+    from tools.registry import registry
+    registry.register(name="phase1_plugin_read",toolset="phase1_domain",schema={"name":"phase1_plugin_read","parameters":{}},handler=lambda args,**kw:"{}")
+    registry.register(name="phase1_plugin_write",toolset="phase1_domain",schema={"name":"phase1_plugin_write","parameters":{}},handler=lambda args,**kw:"{}")
+    parent=SimpleNamespace(platform="bale",enabled_toolsets=["phase1_domain","no_mcp"],disabled_toolsets=[],valid_tool_names={"phase1_plugin_read"})
+    child,disabled=_resolve_child_toolsets(parent,["phase1_domain"],"leaf")
+    assert "phase1_domain" not in child
+
+def test_child_snapshot_enforces_actual_parent_tools():
+    parent=SimpleNamespace(platform="bale",enabled_toolsets=["web"],valid_tool_names={"web_search"},disabled_toolsets=[])
+    child=SimpleNamespace(tools=[{"function":{"name":n}} for n in ["web_search","web_extract","terminal","read_file"]])
+    apply_child_tool_ceiling(child,parent)
+    assert child.valid_tool_names=={"web_search"}
+    assert child._inherited_tool_ceiling==frozenset(parent.valid_tool_names)
+
+def test_readonly_skill_surface_uses_native_resolver():
+    assert set(resolve_toolset("skills_readonly"))=={"skills_list","skill_view"}
+    assert "skill_manage" not in resolve_toolset("skills_readonly")
+
+def test_skills_view_never_runs_inline_shell_or_traverses_host(tmp_path,monkeypatch):
+    import json
+    from tools.skills_tool import skill_view, skills_list
+    home=tmp_path/"home"; skill=home/"skills"/"readonly"; skill.mkdir(parents=True)
+    (home/"config.yaml").write_text("skills:\n  inline_shell: false\n",encoding="utf-8")
+    content="---\nname: readonly\ndescription: Read-only fixture\n---\n!\x60echo must-never-run\x60"
+    (skill/"SKILL.md").write_text(content,encoding="utf-8")
+    secret=home/"secret.txt"; secret.write_text("HOST_SECRET_MUST_NOT_APPEAR")
+    monkeypatch.setenv("HERMES_HOME",str(home))
+    import agent.skill_preprocessing as preprocessing
+    run=Mock(side_effect=AssertionError("Inline shell executed"))
+    monkeypatch.setattr(preprocessing,"run_inline_shell",run)
+    result=skill_view("readonly",task_id="readonly-test")
+    assert "must-never-run" in result
+    assert "readonly" in skills_list(task_id="readonly-test")
+    run.assert_not_called()
+    denied=skill_view("readonly",file_path="../../secret.txt",task_id="readonly-file-test")
+    assert "HOST_SECRET_MUST_NOT_APPEAR" not in denied
+    assert (skill/"SKILL.md").read_text(encoding="utf-8")==content
+
+def test_maintenance_child_inherits_only_registered_domain_tools():
+    from tools.registry import registry
+    names={"maintenance_manual_evidence","maintenance_partbook_lookup"}
+    for name in names:
+        registry.register(name=name,toolset="phase1_maintenance",schema={"name":name,"parameters":{}},handler=lambda args,**kw:"{}")
+    parent=SimpleNamespace(platform="bale",enabled_toolsets=["web","phase1_maintenance","no_mcp"],disabled_toolsets=[],valid_tool_names=names|{"web_search","web_extract","delegate_task"})
+    child,disabled=_resolve_child_toolsets(parent,["web","phase1_maintenance","terminal","file"],"leaf")
+    inherited={n for ts in child for n in resolve_toolset(ts)}
+    assert names <= inherited
+    assert {"web_search","web_extract"} <= inherited
+    assert inherited <= parent.valid_tool_names
+
+@pytest.mark.parametrize("platform",["bale","telegram"])
+def test_gateway_source_scope_is_enforced_without_explicit_wrapper(dns,monkeypatch,platform):
+    monkeypatch.setenv("HERMES_SESSION_PLATFORM",platform)
+    assert not u.is_safe_url("http://10.1.2.3")
+    assert u.is_safe_url("https://example.com")
+    parent=SimpleNamespace(enabled_toolsets=None,disabled_toolsets=[])
+    enabled,_=_resolve_child_toolsets(parent,None,"leaf")
+    assert {n for ts in enabled for n in resolve_toolset(ts)}==set()
+
+def test_messaging_skill_shell_is_denied_even_if_config_regresses(monkeypatch,tmp_path):
+    from agent import skill_preprocessing as p
+    monkeypatch.setenv("HERMES_SESSION_PLATFORM","bale")
+    monkeypatch.setattr(p,"load_skills_config",lambda:{"inline_shell":True})
+    shell=Mock(side_effect=AssertionError("Messaging shell escaped"))
+    monkeypatch.setattr(p,"run_inline_shell",shell)
+    text="Knowledge: !\x60echo must-never-run\x60"
+    assert "must-never-run" in p.preprocess_skill_content(text,tmp_path,"skill-test")
+    shell.assert_not_called()
+
+def test_missing_parent_metadata_never_uses_host_fallback():
+    for parent in (None,SimpleNamespace(),SimpleNamespace(platform="subagent")):
+        assert parent_tool_ceiling(parent)==set()
+        enabled,_=_resolve_child_toolsets(parent,None,"leaf")
+        assert {n for ts in enabled for n in resolve_toolset(ts)}==set()
+
+def test_connect_time_guard_rejects_rebinding(dns,monkeypatch):
+    with public_network_scope():
+        assert u.is_safe_url("https://example.com")
+        monkeypatch.setattr(u,"_getaddrinfo",lambda *_:[(socket.AF_INET,socket.SOCK_STREAM,6,"",("10.1.2.3",443))])
+        with pytest.raises(u.SSRFConnectionBlocked):
+            u._resolved_http_connect_ips("example.com",443,"https")
