+def parent_tool_ceiling(parent_agent):
+    """Exact parent tools, never a whole toolset inferred from a single member."""
+    from tools.invocation_policy import is_messaging_invocation
+    names = getattr(parent_agent, "valid_tool_names", None)
+    inherited = getattr(parent_agent, "_inherited_tool_ceiling", None)
+    if names is not None:
+        ceiling = set(names)
+    else:
+        enabled = getattr(parent_agent, "enabled_toolsets", None)
+        if enabled is None:
+            # No resolved parent means no authority, even if source metadata was lost.
+            # Real CLI agents still inherit their full, explicit loaded tool surface.
+            ceiling = set()
+        else:
+            import model_tools
+            ceiling = model_tools._select_tool_names(
+                list(enabled), getattr(parent_agent, "disabled_toolsets", None), True
+            )
+    return ceiling if inherited is None else ceiling & set(inherited)
