+"""Messaging inherits public capabilities without inheriting local execution or URL opt-outs."""
+import asyncio
+import socket
+from types import SimpleNamespace
+from unittest.mock import Mock
+import pytest
+from tools.invocation_policy import public_network_scope
+from tools import url_safety as u
+from tools.delegate_tool_toolsets import _resolve_child_toolsets, parent_tool_ceiling, apply_child_tool_ceiling
+from toolsets import resolve_toolset
+
+PUBLIC=("https://example.com","https://www.wikipedia.org/wiki/Excavator","http://www.komatsu.com/en/")
+PRIVATE=("http://127.0.0.1","http://127.10.0.5","http://localhost","http://localhost.",
+ "http://0.0.0.0","http://10.1.2.3","http://172.16.2.3","http://192.168.1.8",
+ "http://169.254.169.254","http://100.64.1.2","http://[::1]","http://[fc00::1]",
+ "http://[fe80::1]","http://[::ffff:127.0.0.1]","file:///C:/Windows/win.ini",
+ "C:\\Windows\\win.ini","\\\\server\\share","http://metadata.google.internal")
+
+@pytest.fixture
+def dns(monkeypatch):
+    def resolve(host,port=None,*_):
+        try: ip=socket.inet_ntop(socket.AF_INET6,socket.inet_pton(socket.AF_INET6,host)); family=socket.AF_INET6
+        except OSError:
+            try: ip=socket.inet_ntoa(socket.inet_aton(host)); family=socket.AF_INET
+            except OSError: ip="127.0.0.1" if host.rstrip(".")=="localhost" or host=="private.example" else "93.184.216.34"; family=socket.AF_INET
+        return [(family,socket.SOCK_STREAM,6,"",(ip,port or 80))]
+    monkeypatch.setattr(u,"_getaddrinfo",resolve)
+    monkeypatch.setattr(u,"_resolve_allow_private_urls",lambda:True)
+    monkeypatch.setattr(u,"_proxy_is_configured",lambda:True)
+    u._reset_allow_private_cache()
+    return resolve
+
+@pytest.mark.parametrize("url",PUBLIC)
+def test_public_allowed_despite_legacy_private_optout(dns,url):
+    with public_network_scope():
+        assert u.is_safe_url(url)
+
+@pytest.mark.parametrize("url",PRIVATE+("http://private.example",))
+def test_private_denied_despite_local_backend_and_legacy_optout(dns,url):
+    with public_network_scope():
+        assert not u.is_safe_url(url)
+
+def test_scope_does_not_change_developer_cli(dns):
+    assert u.is_safe_url("http://127.0.0.1")
+    with public_network_scope():
+        assert not u.is_safe_url("http://127.0.0.1")
+    assert u.is_safe_url("http://127.0.0.1")
+
+def test_dns_failure_and_empty_dns_fail_closed_with_proxy(dns,monkeypatch):
+    with public_network_scope():
+        monkeypatch.setattr(u,"_getaddrinfo",lambda *_:[])
+        assert not u.is_safe_url(PUBLIC[0])
+        def fail(*_): raise socket.gaierror()
+        monkeypatch.setattr(u,"_getaddrinfo",fail)
+        assert not u.is_safe_url(PUBLIC[0])
+
+def test_extract_redirect_block_before_private_request(dns):
+    from tools.web_extract_boundary import _check_redirect
+    response=SimpleNamespace(is_redirect=True,url="https://example.com",headers={"location":"http://10.1.2.3/manual"})
+    with public_network_scope(), pytest.raises(u.SSRFConnectionBlocked):
+        _check_redirect(response)
+
+def test_extract_backend_contract_is_required(monkeypatch):
+    from tools import web_extract_boundary as b
+    provider=SimpleNamespace(name="future-local")
+    with pytest.raises(u.SSRFConnectionBlocked):
+        asyncio.run(b.prepare_public_extract_urls(provider,[PUBLIC[0]]))
+    calls=[]
+    monkeypatch.setattr(b,"_public_extract_target",lambda url:calls.append(url) or url)
+    for name in ("parallel","komatso-parallel","future-verified-cloud"):
+        provider=SimpleNamespace(name=name,extract_network_boundary="remote_public")
+        assert asyncio.run(b.prepare_public_extract_urls(provider,[PUBLIC[0]]))==[PUBLIC[0]]
+    assert len(calls)==3
+
+def test_real_extract_dispatch_denies_private_before_backend(dns,monkeypatch):
+    from tools import web_tools as w
+    provider=Mock()
+    monkeypatch.setattr(w,"_resolve_extract_provider",lambda _: (provider,None))
+    with public_network_scope():
+        result=asyncio.run(w.web_extract_tool(["http://192.168.1.1"]))
+    assert "Blocked" in result
+    provider.extract.assert_not_called()
