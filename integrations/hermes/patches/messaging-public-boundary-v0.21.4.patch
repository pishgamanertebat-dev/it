diff --git a/tools/web_extract_boundary.py b/tools/web_extract_boundary.py
new file mode 100644
index 0000000000..9da5ab4f8b
--- /dev/null
+++ b/tools/web_extract_boundary.py
@@ -0,0 +1,37 @@
+"""Public-only extract preflight, independent of the configured provider.
+
+A provider must declare off-host URL fetching to receive messaging URLs. Local
+providers must integrate connect-time policy before declaring support. Unknown
+providers fail closed instead of silently gaining the host's network.
+"""
+import asyncio
+from tools.invocation_policy import public_network_scope
+from tools.url_safety import (
+    create_ssrf_safe_client, is_safe_url, redirect_target_from_response,
+    SSRFConnectionBlocked,
+)
+
+def _check_redirect(response):
+    target = redirect_target_from_response(response)
+    if target and not is_safe_url(target):
+        raise SSRFConnectionBlocked("Blocked: redirect targets a private or internal address")
+
+def _public_extract_target(url):
+    with public_network_scope():
+        with create_ssrf_safe_client(
+            trust_env=False, follow_redirects=True, max_redirects=10,
+            timeout=15, event_hooks={"response": [_check_redirect]},
+        ) as client:
+            # Streaming GET sees real redirects without downloading arbitrary bodies.
+            with client.stream("GET", url) as response:
+                final_url = str(response.url)
+                if not is_safe_url(final_url):
+                    raise SSRFConnectionBlocked("Blocked: extract final URL is not public")
+                return final_url
+
+async def prepare_public_extract_urls(provider, urls):
+    if getattr(provider, "extract_network_boundary", None) != "remote_public":
+        raise SSRFConnectionBlocked(
+            "Blocked: extract provider has no verified public-network fetch boundary"
+        )
+    return await asyncio.gather(*(asyncio.to_thread(_public_extract_target, u) for u in urls))
